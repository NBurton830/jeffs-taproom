{
  "name": "jeffs-taproom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:e2e": "cross-env NODE_OPTIONS=--no-deprecation PORT=3100 DATABASE_URI=file:./data/e2e.db PAYLOAD_SECRET=e2e-secret-not-for-production NEXT_PUBLIC_SITE_URL=http://localhost:3100 ENABLE_TEST_API=1 E2E=1 next dev -p 3100",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:e2e": "node scripts/start-e2e.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed:menu": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:list": "playwright test --list",
    "spec:coverage": "node scripts/spec-coverage.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@libsql/client": "0.14.0",
    "@payloadcms/drizzle": "3.91.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "graphql": "^16.14.2",
    "leaflet": "1.9.4",
    "nanoid": "6.0.2",
    "next": "16.4.2",
    "nodemailer": "10.1.6",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
